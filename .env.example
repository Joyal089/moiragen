# Copy to .env and adjust. This template is safe to commit.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# The creator's name, as the minds hear it in lessons (private: only in your own .env)
CREATOR_NAME=the creator

# Where Moiragen keeps his memory (kept out of Git)
MEMORY_DIR=./memory

# Optional: the Moiragen folder in Google Drive. Finished memory backups are copied there
# by themselves; nothing in it is ever deleted. Example: DRIVE_DIR=G:\My Drive\Moiragen
# DRIVE_DIR=

# Optional: keeping the nanites' words fresh (these are the defaults)
# NANITE_TEMPERATURE_BOOST=0.1   # added to each nanite's own temperature
# OLLAMA_REPEAT_PENALTY=1.15     # above 1.0 avoids repeating words; 1.0 = off
# OLLAMA_REPEAT_LAST_N=-1        # how far back it looks; -1 = the whole prompt

# How much text the model reads at once, in tokens (v3.6). 16384 fits a 6 GB GPU when Ollama
# runs with OLLAMA_FLASH_ATTENTION=1 and OLLAMA_KV_CACHE_TYPE=q8_0 (set as user environment
# variables, then restart Ollama). Check with "ollama ps": it should say 100% GPU.
# OLLAMA_NUM_CTX=16384
